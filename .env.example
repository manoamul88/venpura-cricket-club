# Public domain pointed at your cloud server's public IP.
VENPURA_DOMAIN=team.example.com

# Administrator credentials. Choose a unique username and a strong, private password
# of at least 12 characters; the password is never committed to source control.
VENPURA_ADMIN_USERNAME=your-admin-username
VENPURA_ADMIN_PASSWORD=replace-with-a-long-random-password
VENPURA_ADMIN_FIRST_NAME=Club
VENPURA_ADMIN_LAST_NAME=Admin

# Supabase project URL and private server-only secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-private-supabase-secret-key

# Password reset email (example settings for a Gmail account with 2-Step Verification).
PUBLIC_APP_URL=https://venpura-cricket-club.onrender.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=replace-with-a-google-app-password
SMTP_FROM=VENPURA <your-email@gmail.com>
